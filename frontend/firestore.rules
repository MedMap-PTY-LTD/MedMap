// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null && 
        (request.auth.uid == userId || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow write: if request.auth != null && 
        (request.auth.uid == userId || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Doctors collection
    match /doctors/{doctorId} {
      allow read: if request.auth != null;
      function isAdmin() {
        return request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      function hasNoClientManagedMembershipFields() {
        return !request.resource.data.keys().hasAny([
          'membershipPlanId', 'membershipStatus', 'membershipPeriodEnd',
          'membershipGracePeriodEnd', 'membershipBadge', 'membershipFeatured', 'membershipUpdatedAt'
        ]);
      }
      function preservesServerManagedMembershipFields() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'membershipPlanId', 'membershipStatus', 'membershipPeriodEnd',
          'membershipGracePeriodEnd', 'membershipBadge', 'membershipFeatured', 'membershipUpdatedAt'
        ]);
      }
      allow create: if isAdmin() || (request.auth != null && request.auth.uid == doctorId && hasNoClientManagedMembershipFields());
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == doctorId && preservesServerManagedMembershipFields());
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == doctorId);
    }
    
    // Ambassadors collection
    match /ambassadors/{ambassadorId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (request.auth.uid == ambassadorId || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Admins collection - only admins can read/write
    match /admins/{adminId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Admin logs - only admins can read, system can write
    match /admin_logs/{logId} {
      allow read: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Account credit balances and ledger entries are managed only by the booking service.
    match /accountCredits/{userId} {
      allow read, write: if false;
      match /transactions/{transactionId} {
        allow read, write: if false;
      }
    }
    
    // Tickets
    match /tickets/{ticketId} {
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
        (resource.data.userId == request.auth.uid || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
  }
}
